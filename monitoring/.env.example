# DOMAIN comes from the repo variable; the rest goes in the ENV_monitoring secret.
DOMAIN=example.com

# Grafana break-glass admin login
GRAFANA_ADMIN_PASSWORD=changeme

# Client secret of the "grafana" client in the Keycloak "apps" realm (SSO)
GRAFANA_OAUTH_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
