# GitHub secret ENV_traefik. Double every $ in the htpasswd hash so Compose keeps them.
#   htpasswd -nb admin 'password' | sed 's/\$/\$\$/g'
# VPS_PUBLIC_IP is injected by deploy from SSH_HOST (must be the numeric VPS IP)
# so Twingate public-DNS Resources can hairpin past internal-only.
DOMAIN=example.com
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$hash$$here
