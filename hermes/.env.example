# DOMAIN + TELEGRAM_* come from repo config; the rest goes in the ENV_hermes secret.
DOMAIN=example.com

# Injected from shared secrets by the workflow
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenExampleTokenExample
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_HOME_CHANNEL=123456789

# ENV_hermes: LLM API key(s) + dashboard auth
OPENROUTER_API_KEY=sk-or-v1-example
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=changeme
